NODE_ENV=development
PORT=3000

# PostgreSQL connection string. Never commit a real value.
# DATABASE_URL=postgresql://user:password@host:5432/aventura

# One-time owner bootstrap inputs. Supply these only in the secure runtime
# when running: npm run admin:create-owner
# ADMIN_EMAIL=owner@example.com
# ADMIN_NAME=Aventura Owner
# ADMIN_PASSWORD=use-a-long-unique-password
