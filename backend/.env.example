NODE_ENV=development
PORT=3000

# PostgreSQL connection string. Never commit a real value.
# DATABASE_URL=postgresql://user:password@host:5432/aventura

# Public request ingestion is disabled by default in production. Enable it
# only after the live forms and server-side Turnstile validation are ready.
# PUBLIC_REQUESTS_ENABLED=false
# TURNSTILE_REQUIRED=true
# TURNSTILE_SECRET_KEY=replace-in-secure-runtime
# TURNSTILE_HOSTNAMES=aventuraksa.com,www.aventuraksa.com

# One-time owner bootstrap inputs. Supply these only in the secure runtime
# when running: npm run admin:create-owner
# ADMIN_EMAIL=owner@example.com
# ADMIN_NAME=Aventura Owner
# ADMIN_PASSWORD=use-a-long-unique-password

# Optional notification email delivery. No email is sent unless this group
# is configured in the secure runtime. SMTP_USER/SMTP_PASS are optional as a
# pair for relays that do not require authentication.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=replace-in-runtime
# SMTP_PASS=replace-in-runtime
# SMTP_FROM=Aventura <requests@example.com>
# OPERATIONS_NOTIFICATION_EMAIL=operations@example.com
